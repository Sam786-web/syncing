# ---- Server ----
PORT=4000
# Any long random secret. The desktop and mobile apps must use the same value.
API_KEY=change-me-to-a-long-random-secret

# ---- PostgreSQL ----
# Local:  postgresql://postgres:yourpassword@localhost:5432/cloudsync
# Neon / Supabase: paste their connection string and set DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/cloudsync
DATABASE_SSL=false

# ---- AWS S3 ----
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_BUCKET=my-cloudsync-bucket
# Folder inside the bucket where everything is stored
S3_PREFIX=cloudsync
# Lifetime of view/download links in seconds
SIGNED_URL_TTL=3600
